#!/usr/bin/env ruby
# frozen_string_literal: true

# Prevent broken pipe crash when piped to head/less
trap(:PIPE, "SYSTEM_DEFAULT")

# Flush immediately for streaming output
$stdout.sync = true
$stderr.sync = true

require "rble/cli"

Thor::Base.shell = Thor::Shell::Basic
RBLE::CLI::Main.start(ARGV)
